NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Production only: explicit reverse-proxy source IPs/CIDRs, never arbitrary forwarded headers.
TRUST_PROXY_CIDRS=
DATABASE_URL=postgres://charoo:charoo@localhost:5432/charoo
REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -base64 32. Never reuse the example in production.
MESSAGE_KEY=
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Charoo <hello@localhost>
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=charoo
S3_ACCESS_KEY=charoo
S3_SECRET_KEY=charoo-development-only
# Optional: configure all three to enable consent-based private video calls.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional existing LLM endpoint; must implement OpenAI-compatible chat completions.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# External authenticated malware/content scanner. Fail closed when absent.
MEDIA_SCANNER_URL=
MEDIA_SCANNER_TOKEN=
